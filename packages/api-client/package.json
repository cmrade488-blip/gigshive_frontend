{
  "name": "@gigshive/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generated OpenAPI types and the thin fetch wrapper for the /api/v1 REST API",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/drift-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@gigshive/config": "workspace:*",
    "eslint": "^9.15.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
