{
  "name": "@gigshive/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./money": {
      "types": "./src/money.ts",
      "default": "./src/money.ts"
    },
    "./date": {
      "types": "./src/date.ts",
      "default": "./src/date.ts"
    },
    "./id": {
      "types": "./src/id.ts",
      "default": "./src/id.ts"
    },
    "./idempotency": {
      "types": "./src/idempotency.ts",
      "default": "./src/idempotency.ts"
    },
    "./status-map": {
      "types": "./src/status-map.ts",
      "default": "./src/status-map.ts"
    },
    "./routes": {
      "types": "./src/routes.ts",
      "default": "./src/routes.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@gigshive/config": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.15.0"
