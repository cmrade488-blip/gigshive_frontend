# Copy to .env.local and fill in. Never commit real values. Names are Proposed (Blueprint 13.3).
# Admin runs on a separate origin/port from the marketplace.
API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_SITE_URL=http://localhost:3001
# At least 32 characters in production; seals the server-held session cookie.
SESSION_SECRET=change-me-admin
ALLOWED_GATEWAY_REDIRECT_HOST=
# Included in scrubbed observability events; set to the deploy release in builds.
NEXT_PUBLIC_RELEASE_VERSION=local
# Reserved for the tracker chosen under FOI-02; no SDK or endpoint is wired yet.
SENTRY_DSN=
