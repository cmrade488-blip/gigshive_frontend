{
  "name": "@gigshive/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node ../../scripts/copy-brand-assets.mjs web && next dev --port 3000",
    "build": "node ../../scripts/copy-brand-assets.mjs web && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@gigshive/brand": "workspace:*",
    "@gigshive/config": "workspace:*",
    "@gigshive/shared": "workspace:*",
    "@gigshive/session": "workspace:*",
    "@gigshive/ui": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.17",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
