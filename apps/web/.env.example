# Copy to .env.local and fill in. Never commit real values. Names are Proposed (Blueprint 13.3).
API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_SITE_URL=http://localhost:3000
# Set to "production" in deploy builds. PUBLIC_SITE_URL must then be set to a
# valid http(s) URL without credentials; local builds may use the fallback.
GIGSHIVE_ENV=development
# At least 32 characters in production; seals the server-held session cookie.
SESSION_SECRET=change-me
ALLOWED_GATEWAY_REDIRECT_HOST=
SENTRY_DSN=
# When true, every page renders the 503 maintenance screen. Build-time flag:
# rebuild to apply. A real 503 status code still needs a host/middleware decision.
GIGSHIVE_MAINTENANCE_MODE=false
# Opt in to sample data in production builds. Leave unset until the API is live.
NEXT_PUBLIC_SHOW_SAMPLE_DATA=false
