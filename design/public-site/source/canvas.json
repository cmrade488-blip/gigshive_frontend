  "notes": {
    "title": {
      "x": 0,
      "y": -300,
      "text": "GigsHive: public site and signed-in app screens",
      "kind": "title1",
      "maxW": 5900
    },
    "sample": {
      "x": 6080,
      "y": 0,
      "w": 340,
      "text": "All jobs, names and numbers on these pages are sample content. The real data comes from the API (see Data and State Design). Header and footer are shared components at the bottom: change them once and every page follows.",
      "fill": "orange",
      "size": "s"
    },
    "tokens": {
      "x": 6080,
      "y": 300,
      "w": 340,
      "text": "Colours, fonts and the logo come from brand/ in the repo: honey #F5A000, ink #0F1626, Inter for text, Poppins for the wordmark.",
      "fill": "blue",
      "size": "s"
    },
    "navnote": {
      "x": 6080,
      "y": 600,
      "w": 340,
      "text": "Floating navbar: in the app it is sticky at the top with a 20 px gap, a pill shape and a soft blur. On phones it keeps the logo and Join free, and moves the links into a menu.",
      "fill": "green",
      "size": "s"
    },
    "imgnote": {
      "x": 6080,
      "y": 900,
      "w": 340,
      "text": "Images: see the Image placement map board. Every image in the pages has a data-slot ID that matches the map and the files in brand/images.",
      "fill": "purple",
      "size": "s"
    },
    "featured": {
      "x": 6080,
      "y": 1200,
      "w": 340,
      "text": "Home section \"Meet workers\" needs a public list of workers. The backend does not offer that yet, so treat it as optional until it is added.",
      "fill": "red",
      "size": "s"
    },
    "app": {
      "x": 6080,
      "y": 9640,
      "w": 340,
      "text": "Signed-in screens. Flow: Sign in or Create account (3 steps, same height), then Onboarding (worker: profile and ID check; client: no ID check), then the dashboard for that role. Three dashboards: client, worker, and the staff admin app. Sample data only.",
      "fill": "green",
      "size": "s"
    },
    "roles": {
      "x": 6080,
      "y": 9940,
      "w": 340,
      "text": "Naming: the UI says Client (anyone who hires, person or company) and Worker (anyone who does the work). These match the API. Marketing copy can still say creators or artisans.",
      "fill": "blue",
      "size": "s"
    },
    "inv": {
      "x": 6080,
      "y": 1500,
      "w": 340,
      "text": "Page inventory board (to the right): every page to build, with Designed or To design. System pages (404, 403, 500, 503) are in the row of dark pages near the bottom. In production no server message, code or stack trace is ever shown to users.",
      "fill": "orange",
      "size": "s"
    }
  },
